@{
    ViewData["Title"] = "Historial de pagos";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Mi historial de pagos</h2>
        <p class="text-muted">
            Consulta los pagos que has reportado y verifica su estado.
        </p>
    </div>

    <!-- Resumen de pagos -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Total de pagos</p>
                    <h3 class="fw-bold text-primary">5</h3>
                    <small class="text-muted">Pagos registrados</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Pagos validados</p>
                    <h3 class="fw-bold text-success">3</h3>
                    <small class="text-muted">Pagos aprobados</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Pagos pendientes</p>
                    <h3 class="fw-bold text-warning">1</h3>
                    <small class="text-muted">Esperando validación</small>
                </div>
            </div>
        </div>

    </div>

    <!-- Historial -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Historial de transacciones</h5>
        </div>

        <div class="card-body">

            <!-- Filtros visuales -->
            <div class="row g-3 mb-4">

                <div class="col-md-5">
                    <label class="form-label">Buscar por orden o ID de pago</label>
                    <input type="text" class="form-control"
                           placeholder="Ej. 1001 o 501">
                </div>

                <div class="col-md-4">
                    <label class="form-label">Filtrar por estado</label>
                    <select class="form-select">
                        <option value="">Todos los estados</option>
                        <option>Reportado</option>
                        <option>Validado</option>
                        <option>Rechazado</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary w-100">
                        Limpiar filtros
                    </button>
                </div>

            </div>

            <!-- Tabla de pagos -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>ID de pago</th>
                            <th>Orden</th>
                            <th>Fecha de reporte</th>
                            <th>Monto</th>
                            <th>Método de pago</th>
                            <th>Estado</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>#501</td>
                            <td>#1001</td>
                            <td>15/10/2026</td>
                            <td>₡50,000.00</td>
                            <td>Transferencia bancaria</td>
                            <td>
                                <span class="badge bg-success">
                                    Validado
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td>#502</td>
                            <td>#1002</td>
                            <td>20/10/2026</td>
                            <td>₡75,000.00</td>
                            <td>Depósito bancario</td>
                            <td>
                                <span class="badge bg-warning text-dark">
                                    Reportado
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td>#503</td>
                            <td>#1003</td>
                            <td>22/10/2026</td>
                            <td>₡30,000.00</td>
                            <td>Tarjeta</td>
                            <td>
                                <span class="badge bg-danger">
                                    Rechazado
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td>#504</td>
                            <td>#1001</td>
                            <td>25/10/2026</td>
                            <td>₡25,000.00</td>
                            <td>Transferencia bancaria</td>
                            <td>
                                <span class="badge bg-success">
                                    Validado
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td>#505</td>
                            <td>#1002</td>
                            <td>27/10/2026</td>
                            <td>₡40,000.00</td>
                            <td>Efectivo</td>
                            <td>
                                <span class="badge bg-success">
                                    Validado
                                </span>
                            </td>
                        </tr>

                    </tbody>

                </table>
            </div>

            <div class="text-muted small mt-3">
                Se muestran los pagos registrados en el historial.
            </div>

        </div>
    </div>

</div>
