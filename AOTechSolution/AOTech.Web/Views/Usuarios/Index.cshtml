@model List<AOTech.Web.Controllers.UsuarioViewModel>

@{
    ViewData["Title"] = "Listado de usuarios";
}

<div class="container mt-4">

    <h1>Listado de usuarios</h1>

    <p>
        Usuarios registrados en el sistema.
    </p>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No existen usuarios registrados.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Usuario</th>
                    <th>Nombre completo</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Fecha de creación</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var usuario in Model)
                {
                    <tr>
                        <td>@usuario.UsuarioId</td>

                        <td>@usuario.NombreUsuario</td>

                        <td>@usuario.NombreCompleto</td>

                        <td>@usuario.Correo</td>

                        <td>
                            @usuario.NombreRol
                        </td>

                        <td>
                            @if (usuario.EstaActivo)
                            {
                                <span class="badge bg-success">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactivo
                                </span>
                            }
                        </td>

                        <td>
                            @usuario.FechaCreacion.ToString("dd/MM/yyyy")
                        </td>

                        <td>

                            @if (usuario.EstaActivo)
                            {
                                <!-- CAMBIAR ROL -->
                                <form asp-action="CambiarRol"
                                      method="post"
                                      class="mb-2">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@usuario.UsuarioId" />

                                    <select name="rolId"
                                            class="form-select form-select-sm mb-1">

                                        <option value="1">
                                            Administrador
                                        </option>

                                        <option value="2">
                                            Recepcionista
                                        </option>

                                        <option value="3">
                                            Mecánico
                                        </option>

                                        <option value="4">
                                            Cliente
                                        </option>

                                    </select>

                                    <button type="submit"
                                            class="btn btn-primary btn-sm">
                                        Cambiar rol
                                    </button>

                                </form>


                                <!-- DESACTIVAR -->
                                <form asp-action="Desactivar"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@usuario.UsuarioId" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('¿Está seguro de desactivar este usuario?');">
                                        Desactivar
                                    </button>

                                </form>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Usuario inactivo
                                </span>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>