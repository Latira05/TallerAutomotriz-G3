@model List<AOTech.Web.Models.UsuarioListaViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<section class="seccion">
    <div class="seccion__cabecera">
        <div>
            <h1>Usuarios</h1>
            <p>Cuentas de acceso del personal: administradores, recepción, mecánica y clientes con acceso al sistema.</p>
        </div>
        <a asp-action="Crear" class="btn btn--primario">Nuevo usuario</a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alerta alerta--exito">@TempData["Exito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alerta alerta--error">@TempData["Error"]</div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alerta alerta--error">@ViewBag.Error</div>
    }

    <div class="tabla-wrap">
        @if (Model.Count == 0)
        {
            <div class="tabla-vacia">
                <strong>Todavía no hay usuarios registrados</strong>
                Crea el primero para empezar a dar acceso al sistema.
            </div>
        }
        else
        {
            <table class="tabla">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Nombre completo</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Creado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td class="celda-mono">@usuario.NombreUsuario</td>
                            <td>@usuario.NombreCompleto</td>
                            <td>@usuario.Correo</td>
                            <td>@usuario.Rol</td>
                            <td>
                                @if (usuario.EstaActivo)
                                {
                                    <span class="pastilla pastilla--activo">Activo</span>
                                }
                                else
                                {
                                    <span class="pastilla pastilla--inactivo">Inactivo</span>
                                }
                            </td>
                            <td class="celda-mono">@usuario.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="celda-acciones">
                                    <a asp-action="Editar" asp-route-id="@usuario.UsuarioId" class="btn btn--fantasma btn--pequeno">Editar</a>
                                    <form asp-action="CambiarEstado" method="post">
                                        <input type="hidden" name="id" value="@usuario.UsuarioId" />
                                        <input type="hidden" name="activarlo" value="@(!usuario.EstaActivo)" />
                                        @if (usuario.EstaActivo)
                                        {
                                            <button type="submit" class="btn btn--peligro btn--pequeno">Desactivar</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn--fantasma btn--pequeno">Activar</button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>
