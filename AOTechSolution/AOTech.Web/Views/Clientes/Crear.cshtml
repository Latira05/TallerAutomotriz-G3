@model AOTech.Web.Models.ClienteCrearViewModel

@{
    ViewData["Title"] = "Nuevo cliente";
}

<section class="seccion">
    <div class="seccion__cabecera">
        <div>
            <h1>Nuevo cliente</h1>
            <p>Registra al cliente y su cuenta de acceso. El código de cliente frecuente se genera automáticamente.</p>
        </div>
    </div>

    <div class="form-card form-card--ancho">
        <form asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="alerta alerta--error" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <h2 class="form-subtitulo">Datos del cliente</h2>

            <div class="campo">
                <label asp-for="NombreCompleto"></label>
                <input asp-for="NombreCompleto" autocomplete="off" />
                <span asp-validation-for="NombreCompleto" class="validacion"></span>
            </div>

            <div class="campo">
                <label asp-for="Telefono"></label>
                <input asp-for="Telefono" type="tel" autocomplete="off" />
                <span asp-validation-for="Telefono" class="validacion"></span>
            </div>

            <div class="campo">
                <label asp-for="Direccion"></label>
                <textarea asp-for="Direccion" rows="3"></textarea>
                <span asp-validation-for="Direccion" class="validacion"></span>
            </div>

            <h2 class="form-subtitulo form-subtitulo--sep">Cuenta de acceso</h2>

            <div class="campos-dos">
                <div class="campo">
                    <label asp-for="NombreUsuario"></label>
                    <input asp-for="NombreUsuario" autocomplete="off" />
                    <span asp-validation-for="NombreUsuario" class="validacion"></span>
                </div>

                <div class="campo">
                    <label asp-for="Correo"></label>
                    <input asp-for="Correo" type="email" autocomplete="off" />
                    <span asp-validation-for="Correo" class="validacion"></span>
                </div>
            </div>

            <div class="campo">
                <label asp-for="Contrasena"></label>
                <input asp-for="Contrasena" type="password" autocomplete="new-password" />
                <span class="ayuda">Mínimo 6 caracteres.</span>
                <span asp-validation-for="Contrasena" class="validacion"></span>
            </div>

            <div class="form-acciones">
                <button type="submit" class="btn btn--primario">Registrar cliente</button>
                <a asp-action="Index" class="btn btn--fantasma">Cancelar</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
