@model List<AOTech.Web.Models.VehiculoListaViewModel>

@{
    ViewData["Title"] = "Vehículos";
    var buscar = ViewBag.Buscar as string;
    var hayBusqueda = !string.IsNullOrWhiteSpace(buscar);
}

<section class="seccion">
    <div class="seccion__cabecera">
        <div>
            <h1>Vehículos</h1>
            <p>Vehículos registrados y asociados a sus clientes propietarios.</p>
        </div>
        <a asp-action="Crear" class="btn btn--primario">Nuevo vehículo</a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alerta alerta--exito">@TempData["Exito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alerta alerta--error">@TempData["Error"]</div>
    }

    <form method="get" asp-action="Index" class="barra-busqueda">
        <input type="search" name="buscar" value="@buscar" placeholder="Buscar por placa, marca, modelo o cliente" />
        <button type="submit" class="btn btn--fantasma">Buscar</button>
        @if (hayBusqueda)
        {
            <a asp-action="Index" class="btn btn--fantasma">Limpiar</a>
        }
    </form>

    <div class="tabla-wrap">
        @if (Model.Count == 0)
        {
            <div class="tabla-vacia">
                @if (hayBusqueda)
                {
                    <strong>Sin resultados</strong>
                    <text>No hay vehículos que coincidan con "@buscar".</text>
                }
                else
                {
                    <strong>Todavía no hay vehículos registrados</strong>
                    <text>Registra el primero para empezar a llevar el control.</text>
                }
            </div>
        }
        else
        {
            <table class="tabla">
                <thead>
                    <tr>
                        <th>Placa</th>
                        <th>Vehículo</th>
                        <th>Cliente</th>
                        <th>Kilometraje</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vehiculo in Model)
                    {
                        <tr>
                            <td class="celda-mono">@vehiculo.Placa</td>
                            <td>@vehiculo.Marca @vehiculo.Modelo @vehiculo.Anio</td>
                            <td>
                                <div>@vehiculo.NombreCliente</div>
                                <small class="celda-mono">@vehiculo.CodigoClienteFrecuente</small>
                            </td>
                            <td class="celda-mono">@vehiculo.Kilometraje.ToString("N0") km</td>
                            <td>
                                @if (vehiculo.EstaActivo)
                                {
                                    <span class="pastilla pastilla--activo">Activo</span>
                                }
                                else
                                {
                                    <span class="pastilla pastilla--inactivo">Inactivo</span>
                                }
                            </td>
                            <td>
                                <div class="celda-acciones">
                                    <a asp-action="Detalles" asp-route-id="@vehiculo.VehiculoId" class="btn btn--fantasma btn--pequeno">Ver</a>
                                    <a asp-action="Editar" asp-route-id="@vehiculo.VehiculoId" class="btn btn--fantasma btn--pequeno">Editar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>
