<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — A.O Tech</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <header class="topbar">
        <div class="topbar__inner">
            <a asp-controller="Home" asp-action="Index" class="marca">A<span>.</span>O TECH</a>
            <nav>
                <ul class="nav-principal">
                    <li><a asp-controller="Home" asp-action="Index">Panel</a></li>
                    <li><a asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main class="contenedor">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="contenedor footer__inner">
            <span>A.O Tech — sistema interno de gestión</span>
            <span>&copy; @DateTime.Now.Year</span>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
